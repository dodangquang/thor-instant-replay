<resources>
<style name="Replay" />
<style name="Replay.Button" parent="Widget.MaterialComponents.Button">
 <item name="android:layout_width">match_parent</item><item name="android:layout_height">48dp</item>
 <item name="android:textSize">12sp</item><item name="android:textStyle">bold</item><item name="android:fontFamily">sans-serif-condensed</item>
 <item name="android:insetTop">3dp</item><item name="android:insetBottom">3dp</item>
 <item name="backgroundTint">@color/nvidia_card_inner</item><item name="android:textColor">@color/nvidia_green</item>
 <item name="strokeColor">@color/replay_focus_stroke</item><item name="strokeWidth">2dp</item><item name="cornerRadius">0dp</item>
 <item name="shapeAppearanceOverlay">@style/Replay.CutCorners</item>
 <item name="android:focusable">true</item><item name="android:paddingHorizontal">8dp</item>
</style>
<style name="Replay.CutCorners"><item name="cornerFamily">cut</item><item name="cornerSizeTopRight">10dp</item><item name="cornerSizeBottomLeft">10dp</item></style>
<style name="Replay.Section"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/nvidia_green</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold|italic</item><item name="android:layout_marginTop">12dp</item><item name="android:layout_marginBottom">6dp</item></style>
<style name="Replay.Hint"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">12sp</item><item name="android:lineSpacingExtra">3dp</item><item name="android:layout_marginVertical">6dp</item></style>
<style name="Replay.Status" parent="Replay.Section"><item name="android:textSize">14sp</item><item name="android:minHeight">20dp</item></style>
<style name="Replay.SectionLayout"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item></style>
<style name="Replay.Chip" parent="Widget.MaterialComponents.Chip.Choice"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">48dp</item><item name="android:textColor">@color/replay_chip_text</item><item name="chipBackgroundColor">@color/replay_chip_bg</item><item name="chipStrokeColor">@color/replay_focus_stroke</item><item name="chipStrokeWidth">2dp</item><item name="chipCornerRadius">0dp</item><item name="android:focusable">true</item><item name="android:textSize">12sp</item></style>
<style name="Replay.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">50dp</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">14sp</item><item name="android:paddingHorizontal">8dp</item><item name="android:background">@drawable/replay_control_focus</item><item name="android:focusable">true</item></style>
</resources>
