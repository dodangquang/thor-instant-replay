<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nvidia_dark_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- NVIDIA Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NVIDIA"
                android:textColor="@color/nvidia_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SHADOWPLAY"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AYN THOR"
                android:textColor="@color/nvidia_black"
                android:background="@color/nvidia_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Status HUD Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_stopped"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFpsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 FPS"
                        android:textColor="@color/nvidia_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBufferStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="RAM Buffer: 0 MB • 0 khung hình • 1080p Canvas"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleService"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_start"
                        android:backgroundTint="@color/nvidia_green"
                        android:textColor="@color/nvidia_black"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveClip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/btn_save_clip"
                        android:backgroundTint="@color/nvidia_card_inner"
                        android:textColor="@color/nvidia_green"
                        android:textStyle="bold"
                        app:strokeColor="@color/nvidia_green"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="6dp"
                        android:enabled="false" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManualRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_manual_record_start"
                    android:backgroundTint="@color/nvidia_card_inner"
                    android:textColor="#ff5555"
                    android:textStyle="bold"
                    app:strokeColor="#ff5555"
                    app:strokeWidth="1.2dp"
                    app:cornerRadius="6dp"
                    android:enabled="false" />


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Duration Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_duration"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip30s"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 GIÂY"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip60s"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 GIÂY"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip120s"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 GIÂY (2 PHÚT)"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Video Quality & Storage Quota Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_resolution"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1080p"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1080P 60FPS (16 MBPS)"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip720p"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720P 60FPS (8 MBPS)"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_quota"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupQuota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuota30"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 CLIPS"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuota50"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 CLIPS"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuotaUnlimited"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KHÔNG GIỚI HẠN"
                        android:textColor="@color/white"
                        app:chipBackgroundColor="@color/nvidia_card_inner"
                        app:chipStrokeColor="@color/nvidia_card_stroke"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Audio Mixer Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_audio_mixer_title"
                    android:textColor="@color/nvidia_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Game Volume Slider -->
                <TextView
                    android:id="@+id/tvGameVolumeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Âm lượng Game: 85%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderGameVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="150"
                    android:stepSize="5"
                    android:value="85"
                    app:thumbColor="@color/nvidia_green"
                    app:trackColorActive="@color/nvidia_green"
                    app:trackColorInactive="@color/nvidia_card_inner" />

                <!-- Mic Volume Slider -->
                <TextView
                    android:id="@+id/tvMicVolumeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Âm lượng Micro (Voice Boost): 150%"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khuếch đại giọng nói to rõ hơn tiếng game, chống bị lấn át khi chơi game"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMicVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="50"
                    android:valueTo="300"
                    android:stepSize="10"
                    android:value="150"
                    app:thumbColor="@color/nvidia_green"
                    app:trackColorActive="@color/nvidia_green"
                    app:trackColorInactive="@color/nvidia_card_inner" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TÍNH NĂNG &amp; PHÍM TẮT THIẾT BỊ"
                    android:textColor="@color/nvidia_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <!-- Dual Screen Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDualScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/setting_dual_screen"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghép màn hình chính (Top 1080p) + phụ (Bottom 1240p) thành video chuẩn 1080x2320"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Home Button 5s Trigger Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swHomeHold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_home_hold"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đè phím HOME đúng 3 giây để lưu clip mà không làm gián đoạn tráo màn hình của Thor Wayfinder"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Instant L3 + R3 Combo Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swInstantL3R3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_instant_combo"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhấn đồng thời 2 cần analog L3 + R3 để lưu clip ngay lập tức với độ trễ 0s (không cần chờ đè 3s)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />


                <!-- Floating Button Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFloatingButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_floating_button"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hiện nút nổi xanh neon mờ để chạm lưu clip trực tiếp từ màn hình cảm ứng dưới"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Record Mic Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRecordMic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_record_mic"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi âm tiếng micro và trộn (mix) trực tiếp vào âm thanh game với độ trễ siêu thấp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Noise Filter Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNoiseFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_noise_filter"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bộ lọc DSP mã nguồn mở: Cắt tiếng ồn quạt AYN Thor (Low-Cut 90Hz) + Noise Gate thông minh"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Pause on Screen Off Switch (Doze Mode) -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPauseScreenOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_pause_screen_off"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động tạm dừng VPU &amp; Micro khi tắt màn hình để máy AYN Thor vào chế độ ngủ sâu (Doze Mode tiết kiệm pin)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Auto-boot Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoBoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_boot"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <!-- Sound Chime Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSoundChime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/setting_sound_chime"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    app:thumbTint="@color/nvidia_green"
                    app:trackTint="@color/nvidia_green_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phát tiếng 'Ting' thanh nhẹ kiểu Nintendo Switch / PS5 khi clip lưu xong thành công"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ADB Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/nvidia_card_bg"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/nvidia_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvAdbStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_status_ok"
                    android:textColor="@color/nvidia_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saved Clips List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_clips"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWifiShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_wifi_share"
                android:backgroundTint="@color/nvidia_card_inner"
                android:textColor="@color/nvidia_green"
                android:textSize="11sp"
                android:textStyle="bold"
                app:strokeColor="@color/nvidia_green"
                app:strokeWidth="1.2dp"
                app:cornerRadius="6dp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutClipsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
