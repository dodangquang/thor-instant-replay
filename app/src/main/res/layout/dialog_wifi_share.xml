<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/nvidia_dark_bg" android:orientation="horizontal"
    android:padding="18dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/ivQrCode" android:layout_width="180dp" android:layout_height="180dp"
        android:padding="8dp" android:background="@color/white" android:layout_marginEnd="18dp"
        android:contentDescription="@string/qr_description" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/dialog_wifi_share_title" android:textColor="@color/nvidia_green"
            android:textSize="18sp" android:textStyle="bold|italic" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/dialog_wifi_share_desc" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/tvServerUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/share_hint" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCloseShare" style="@style/Replay.Button"
            android:layout_marginTop="12dp" android:text="@string/dialog_btn_stop_share" />
    </LinearLayout>
</LinearLayout>
